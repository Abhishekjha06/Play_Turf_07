# Supabase Configuration
# Copy this file to `.env.local` and fill in your project's values
# (Supabase Dashboard → Project Settings → API).
# Never commit real keys — `.env.local` is gitignored.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key_here

# ── SEO / Analytics (all optional) ─────────────────────────────
# Canonical production origin used for meta/OG/sitemap URLs.
VITE_SITE_ORIGIN=https://playturf.app
# Google Analytics 4 measurement ID (leave unset to disable GA4 entirely).
# VITE_GA4_ID=G-XXXXXXXXXX
# Google Search Console HTML verification token (Dashboard URL-prefix method).
# VITE_GSC_VERIFICATION=verification-token-from-google



# PostHog Analytics
VITE_POSTHOG_KEY=your_posthog_project_api_key_here
VITE_POSTHOG_HOST=https://app.posthog.com

# Sentry Error Tracking (Optional)
VITE_SENTRY_DSN=your_sentry_dsn_here

# vAPID Public Key for Push Notifications
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Razorpay (If applicable)
# VITE_RAZORPAY_KEY=your_razorpay_key_here
